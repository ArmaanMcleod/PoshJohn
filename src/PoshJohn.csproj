<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net6.0</TargetFramework>
    <LangVersion>10.0</LangVersion>
    <CopyLocalLockFileAssemblies>true</CopyLocalLockFileAssemblies>
    <AssemblyName>PoshJohn</AssemblyName>
    <RootNamespace>PoshJohn</RootNamespace>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="SharpZipLib" Version="1.4.2" />
    <PackageReference Include="System.Management.Automation" Version="7.2.0" PrivateAssets="all" />
    <PackageReference Include="itext" Version="9.1.0" />
    <PackageReference Include="itext.bouncy-castle-adapter" Version="9.1.0" />
  </ItemGroup>

  <ItemGroup>
    <None Include="PoshJohn.psd1" CopyToOutputDirectory="PreserveNewest" />
    <None Include="PoshJohn.psm1" CopyToOutputDirectory="PreserveNewest" />
  </ItemGroup>

  <ItemGroup Condition=" '$(SKIP_NATIVE_BUILD)' != 'true' ">
    <None Include="pdf2john/dist/pdf2john" CopyToOutputDirectory="PreserveNewest" Link="pdf2john/pdf2john" Condition=" $([System.OperatingSystem]::IsLinux()) Or $([System.OperatingSystem]::IsMacOS()) " />
    <None Include="pdf2john/dist/libpdfhash.so" CopyToOutputDirectory="PreserveNewest" Link="pdf2john/libpdfhash.so" Condition=" $([System.OperatingSystem]::IsLinux()) " />
    <None Include="pdf2john/dist/libpdfhash.dylib" CopyToOutputDirectory="PreserveNewest" Link="pdf2john/libpdfhash.dylib" Condition=" $([System.OperatingSystem]::IsMacOS()) " />
    <None Include="pdf2john/dist/pdf2john.exe" CopyToOutputDirectory="PreserveNewest" Link="pdf2john/pdf2john.exe" Condition=" $([System.OperatingSystem]::IsWindows()) " />
    <None Include="pdf2john/dist/libpdfhash.dll" CopyToOutputDirectory="PreserveNewest" Link="pdf2john/libpdfhash.dll" Condition=" $([System.OperatingSystem]::IsWindows()) " />
  </ItemGroup>

  <ItemGroup Condition=" '$(SKIP_NATIVE_BUILD)' != 'true' ">
    <None Include="../john/**" CopyToOutputDirectory="PreserveNewest" Link="john/%(RecursiveDir)%(Filename)%(Extension)" />
  </ItemGroup>

  <Target Name="CleanObjAndBinDirectories" AfterTargets="Clean">
    <RemoveDir Directories="$(BaseOutputPath)" />
    <RemoveDir Directories="$(BaseIntermediateOutputPath)" />
  </Target>

</Project>
