{
    // See https://go.microsoft.com/fwlink/?LinkId=733558
    // for the documentation about the tasks.json format
    "version": "2.0.0",
    "tasks": [
        {
            "label": "Build",
            "type": "shell",
            "command": "& ./PowerShellBuildTools/build.ps1",
            "group": {
                "kind": "build",
                "isDefault": true
            },
            "problemMatcher": "$msCompile",
            "options": {
                "env": {
                    "SKIP_NATIVE_BUILD_ASSETS": "${input:SkipNativeBuild}",
                    "SKIP_NATIVE_COPY_ASSETS": "false"
                }
            }
        }
    ],
    "inputs": [
        {
            "id": "SkipNativeBuild",
            "type": "promptString",
            "description": "Set to 'true' to skip building native components.",
            "default": "false"
        }
    ]
}
